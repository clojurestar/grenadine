#!/usr/bin/env bash

set -euo pipefail

grenadine=${GRENADINE:?GRENADINE is required}
top=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
version=$(< "$top/VERSION")
version_pattern=${version//./\\.}
temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT

failures=0
checks=0

check() {
  local description=$1 expected_status=$2 expected_pattern=$3
  shift 3
  local output status
  set +e
  output=$("$@" 2>&1)
  status=$?
  set -e
  checks=$((checks + 1))
  if [[ $status != "$expected_status" ]] ||
     ! grep -Eq -- "$expected_pattern" <<< "$output"; then
    echo "not ok $checks - $description" >&2
    echo "  status: $status" >&2
    echo "  output: $output" >&2
    failures=$((failures + 1))
  else
    echo "ok $checks - $description"
  fi
}

check_empty() {
  local description=$1 expected_status=$2
  shift 2
  local output status
  set +e
  output=$("$@" 2>&1)
  status=$?
  set -e
  checks=$((checks + 1))
  if [[ $status != "$expected_status" || -n $output ]]; then
    echo "not ok $checks - $description" >&2
    echo "  status: $status" >&2
    echo "  output: $output" >&2
    failures=$((failures + 1))
  else
    echo "ok $checks - $description"
  fi
}

check_exact() {
  local description=$1 expected_status=$2 expected_output=$3
  shift 3
  local output status
  set +e
  output=$("$@" 2>&1)
  status=$?
  set -e
  checks=$((checks + 1))
  if [[ $status != "$expected_status" || $output != "$expected_output" ]]; then
    echo "not ok $checks - $description" >&2
    echo "  status: $status" >&2
    echo "  output: $output" >&2
    failures=$((failures + 1))
  else
    echo "ok $checks - $description"
  fi
}

seed_repo() {
  local repository=$1
  local base=$repository/org/example/demo/1.0.0
  mkdir -p "$base"
  printf '%s\n' \
    '<project>' \
    '  <modelVersion>4.0.0</modelVersion>' \
    '  <groupId>org.example</groupId>' \
    '  <artifactId>demo</artifactId>' \
    '  <version>1.0.0</version>' \
    '</project>' > "$base/demo-1.0.0.pom"
  printf 'fixture jar\n' > "$base/demo-1.0.0.jar"
}

seed_list_repo() {
  local repository=$1
  seed_repo "$repository"
  mkdir -p \
    "$repository/org/alpha/example/2.0.0" \
    "$repository/org/parent/bom/3.0.0"
  printf 'fixture jar\n' \
    > "$repository/org/alpha/example/2.0.0/example-2.0.0.jar"
  printf 'sources jar\n' \
    > "$repository/org/alpha/example/2.0.0/example-2.0.0-sources.jar"
  printf '<project/>\n' \
    > "$repository/org/parent/bom/3.0.0/bom-3.0.0.pom"
}

write_pom() {
  local repository=$1 group=$2 artifact=$3 version=$4 dependencies=$5
  local group_path=${group//./\/}
  local base=$repository/$group_path/$artifact/$version
  mkdir -p "$base"
  printf '%s\n' \
    '<project>' \
    '  <modelVersion>4.0.0</modelVersion>' \
    "  <groupId>$group</groupId>" \
    "  <artifactId>$artifact</artifactId>" \
    "  <version>$version</version>" \
    "  <dependencies>$dependencies</dependencies>" \
    '</project>' > "$base/$artifact-$version.pom"
}

seed_resolve_repo() {
  local repository=$1
  write_pom "$repository" demo root 1.0.0 \
    '<dependency><groupId>demo</groupId><artifactId>c</artifactId><version>1.0.0</version></dependency><dependency><groupId>demo</groupId><artifactId>branch</artifactId><version>1.0.0</version></dependency>'
  write_pom "$repository" demo branch 1.0.0 \
    '<dependency><groupId>demo</groupId><artifactId>c</artifactId><version>2.0.0</version></dependency>'
  write_pom "$repository" demo c 1.0.0 ''
  write_pom "$repository" demo c 2.0.0 ''
}

write_deps() {
  local file=$1 local_repo=${2:-}
  if [[ $local_repo ]]; then
    printf '{:mvn/local-repo "%s" :deps {org.example/demo {:mvn/version "1.0.0"}}}\n' \
      "$local_repo" > "$file"
  else
    printf '{:deps {org.example/demo {:mvn/version "1.0.0"}}}\n' > "$file"
  fi
}

check "version" 0 "^grenadine v${version_pattern}$" "$grenadine" --version
check "removed version shortcut" 1 'unknown option: -V' "$grenadine" -V
check "help" 0 '^Usage: grenadine' "$grenadine" --help
help_output=$("$grenadine" --help)
check_exact "no arguments show help" 0 "$help_output" "$grenadine"
check "unknown option" 1 'unknown option: --wat' "$grenadine" --wat
check "removed repo option" 1 'unknown option: --repo' "$grenadine" --repo=somewhere
check "bare deps source rejected" 1 'an explicit operation is required' \
  "$grenadine" deps.edn
check "removed resolve option" 1 'unknown option: --resolve' \
  "$grenadine" --resolve demo/root
check "removed resolver option" 1 'unknown option: --resolver' \
  "$grenadine" --resolver newest --expand demo/root
check "removed resolvers option" 1 'unknown option: --resolvers' \
  "$grenadine" --resolvers

list_repo="$temporary/list repo"
seed_list_repo "$list_repo"
check_exact "list repository" 0 \
  $'org.alpha/example 2.0.0\norg.example/demo 1.0.0' \
  "$grenadine" --repository "$list_repo" --list
check_exact "list environment repository" 0 \
  $'org.alpha/example 2.0.0\norg.example/demo 1.0.0' \
  env GRENADINE_LOCAL_REPOSITORY="$list_repo" "$grenadine" --list
check_empty "quiet list" 0 \
  "$grenadine" --quiet --repository="$list_repo" --list
check "operation conflict" 1 \
  '--list, --add, --delete, --remove, --expand, and --mediators are mutually exclusive' \
  "$grenadine" --list --add org.example/demo 1.0.0

check_exact "list mediation strategies" 0 \
  $'newest     Select the highest Maven-compatible version\nnearest    Select the shortest path, then declaration order\ntools-deps Preserve direct dependencies; otherwise select newest (default)' \
  "$grenadine" --mediators
check "mediators reject quiet" 1 '--mediators does not use --quiet' \
  "$grenadine" --quiet --mediators
check "mediators reject items" 1 '--mediators does not accept items' \
  "$grenadine" --mediators demo/root
check "mediators reject repository" 1 '--mediators does not use --repository' \
  "$grenadine" --repository somewhere --mediators
check "mediators reject gitlibs" 1 '--mediators does not use --gitlibs' \
  "$grenadine" --gitlibs somewhere --mediators
check "mediator rejects unknown strategy" 1 \
  'unknown mediation strategy: random' \
  "$grenadine" --mediator=random --expand demo/root 1.0.0
check "mediator rejects plain list" 1 \
  '--mediator is only valid' "$grenadine" --mediator newest --list
check "mediator requires a compatible operation" 1 \
  '--mediator is only valid' "$grenadine" --mediator newest
check "expand requires an item" 1 \
  '--expand requires at least one item' "$grenadine" --expand

resolve_repo="$temporary/resolve repo"
seed_resolve_repo "$resolve_repo"
write_pom "$resolve_repo" hiccup hiccup 1.0.5 ''
write_pom "$resolve_repo" org.lwjgl lwjgl-stb 3.2.3 ''
check_exact "expand unqualified legacy library" 0 \
  'hiccup 1.0.5' \
  "$grenadine" --repository "$resolve_repo" --expand hiccup 1.0.5
check_exact "expand Maven classifier" 0 \
  "org.lwjgl/lwjgl-stb\$natives-macos 3.2.3" \
  "$grenadine" --repository "$resolve_repo" --expand \
    "org.lwjgl/lwjgl-stb\$natives-macos" 3.2.3
check_exact "expand defaults to tools-deps" 0 \
  $'demo/branch 1.0.0\ndemo/c 2.0.0\ndemo/root 1.0.0' \
  "$grenadine" --repository "$resolve_repo" --expand demo/root 1.0.0
check_exact "expand with nearest" 0 \
  $'demo/branch 1.0.0\ndemo/c 1.0.0\ndemo/root 1.0.0' \
  "$grenadine" --repository "$resolve_repo" --mediator=nearest \
    --expand demo/root 1.0.0
check_exact "expand with short mediator" 0 \
  $'demo/branch 1.0.0\ndemo/c 2.0.0\ndemo/root 1.0.0' \
  "$grenadine" --repository "$resolve_repo" -M newest \
    --expand demo/root 1.0.0
check_exact "expand with short option" 0 \
  $'demo/branch 1.0.0\ndemo/c 2.0.0\ndemo/root 1.0.0' \
  "$grenadine" --repository "$resolve_repo" -X demo/root 1.0.0
check_exact "tools-deps preserves direct root" 0 \
  $'demo/branch 1.0.0\ndemo/c 1.0.0\ndemo/root 1.0.0' \
  "$grenadine" --repository "$resolve_repo" --mediator=tools-deps \
    --expand demo/root 1.0.0 demo/c 1.0.0
check_empty "quiet expand" 0 \
  "$grenadine" --quiet --repository "$resolve_repo" \
    --expand demo/root 1.0.0
check_empty "expand installs no jars" 0 \
  find "$resolve_repo" -name '*.jar' -print

printf 'fixture jar\n' > "$resolve_repo/demo/root/1.0.0/root-1.0.0.jar"
check_exact "list expanded graph marks missing jars" 0 \
  $'demo/branch 1.0.0 MISSING\ndemo/c 2.0.0 MISSING\ndemo/root 1.0.0\n=> Installed: 1  Missing: 2  Total: 3' \
  "$grenadine" --repository "$resolve_repo" --list demo/root 1.0.0
check_empty "quiet expanded list" 0 \
  "$grenadine" --quiet --repository "$resolve_repo" \
    --list demo/root 1.0.0

mixed_deps="$temporary/mixed-deps.edn"
printf '{:mvn/local-repo "%s" :deps {demo/root {:mvn/version "1.0.0"}}}\n' \
  "$resolve_repo" > "$mixed_deps"
check_exact "mixed source and name use last root" 0 \
  $'demo/branch 1.0.0\ndemo/c 1.0.0\ndemo/root 1.0.0' \
  "$grenadine" --expand "$mixed_deps" demo/c 1.0.0

for artifact in branch/1.0.0/branch-1.0.0 c/1.0.0/c-1.0.0 \
  c/2.0.0/c-2.0.0; do
  printf 'fixture jar\n' > "$resolve_repo/demo/$artifact.jar"
done
check_exact "remove expanded closure" 0 \
  $'Removed demo/branch 1.0.0\nRemoved demo/c 2.0.0\nRemoved demo/root 1.0.0\n=> Removed: 3  Missing: 0  Total: 3' \
  "$grenadine" --repository "$resolve_repo" --remove demo/root 1.0.0
check_empty "remove leaves unselected version" 0 \
  test -e "$resolve_repo/demo/c/1.0.0/c-1.0.0.jar"

add_repo="$temporary/add repo"
seed_repo "$add_repo"
check_exact "add explicit version" 0 \
  '=> Installed: 0  Already: 1  Total: 1' \
  "$grenadine" --mediator=newest --repository "$add_repo" \
    --add org.example/demo 1.0.0
check_empty "quiet add" 0 \
  "$grenadine" --quiet --repository "$add_repo" \
    --add org.example/demo 1.0.0
check "add requires an item" 1 '--add requires at least one item' \
  "$grenadine" --add
check "add rejects unreadable source" 1 'cannot read missing.edn' \
  "$grenadine" --add missing.edn

remove_repo="$temporary/remove repo"
seed_list_repo "$remove_repo"
check_exact "delete one version" 0 \
  $'Deleted org.example/demo 1.0.0\n=> Deleted: 1  Missing: 0  Total: 1' \
  "$grenadine" --repository "$remove_repo" \
    --delete org.example/demo 1.0.0
check_empty "removed version is gone" 0 \
  test ! -e "$remove_repo/org/example/demo/1.0.0"
check_exact "delete all versions" 0 \
  $'Deleted org.alpha/example (all versions)\n=> Deleted: 1  Missing: 0  Total: 1' \
  "$grenadine" --repository "$remove_repo" --delete org.alpha/example
check_empty "removed artifact is gone" 0 \
  test ! -e "$remove_repo/org/alpha/example"

mkdir -p \
  "$remove_repo/org/example/multi/1.0.0" \
  "$remove_repo/org/example/multi/2.0.0"
check_exact "delete multiple explicit versions" 0 \
  $'Deleted org.example/multi 1.0.0\nDeleted org.example/multi 2.0.0\n=> Deleted: 2  Missing: 0  Total: 2' \
  "$grenadine" --repository "$remove_repo" --delete \
    org.example/multi 1.0.0 org.example/multi 2.0.0
check_exact "missing removal succeeds" 0 \
  $'Missing org.example/missing 9.0\n=> Deleted: 0  Missing: 1  Total: 1' \
  "$grenadine" --repository "$remove_repo" \
    --delete org.example/missing 9.0
mkdir -p "$remove_repo/org/example/quiet/1.0.0"
check_empty "quiet remove" 0 \
  "$grenadine" --quiet --repository "$remove_repo" \
    --delete org.example/quiet 1.0.0
check "delete requires an item" 1 \
  '--delete requires at least one item' "$grenadine" --delete
check "delete rejects unsafe name" 1 'invalid library name' \
  "$grenadine" --repository "$remove_repo" --delete ../outside
check "delete rejects Maven classifier" 1 'do not support Maven classifiers' \
  "$grenadine" --repository "$remove_repo" --delete \
    "org.lwjgl/lwjgl-stb\$natives-macos" 3.2.3
mkdir -p "$remove_repo/org/example/safe/1.0.0"
check "remove validates before deleting" 1 'invalid library name' \
  "$grenadine" --repository "$remove_repo" --delete \
    org.example/safe 1.0.0 ../outside
check_empty "preflight preserves valid target" 0 \
  test -d "$remove_repo/org/example/safe/1.0.0"
check "delete rejects unsafe version" 1 'invalid version' \
  "$grenadine" --repository "$remove_repo" --delete \
    org.example/safe "bad\\version"
check "delete rejects duplicate request" 1 'duplicate deletion request' \
  "$grenadine" --delete org.example/safe 1 org.example/safe 1
check "delete rejects mixed all-version request" 1 \
  'cannot combine all-version and version deletions' \
  "$grenadine" --delete org.example/safe org.example/safe 1

deps_file="$temporary/deps file.edn"
explicit_repo="$temporary/explicit repo"
seed_repo "$explicit_repo"
write_deps "$deps_file"
check "long repository option" 0 '^=> Installed: 0  Already: 1  Total: 1$' \
  "$grenadine" --mediator=nearest "--repository=$explicit_repo" \
    --add "$deps_file"
check "short repository option" 0 '^=> Installed: 0  Already: 1  Total: 1$' \
  "$grenadine" -R "$explicit_repo" --add "$deps_file"
check_empty "short quiet option" 0 \
  "$grenadine" -q -R "$explicit_repo" --add "$deps_file"
check_empty "long quiet option" 0 \
  "$grenadine" --quiet --repository "$explicit_repo" --add "$deps_file"

file_repo="$temporary/file repo"
seed_repo "$file_repo"
write_deps "$deps_file" "$file_repo"
check "deps file repository" 0 '^=> Installed: 0  Already: 1  Total: 1$' \
  "$grenadine" --add "$deps_file"

environment_repo="$temporary/environment repo"
seed_repo "$environment_repo"
write_deps "$deps_file"
check "environment repository" 0 '^=> Installed: 0  Already: 1  Total: 1$' \
  env GRENADINE_LOCAL_REPOSITORY="$environment_repo" \
  "$grenadine" --add "$deps_file"

printf '[]\n' > "$deps_file"
check "top-level map validation" 1 'must contain an EDN map' \
  "$grenadine" --add "$deps_file"

printf '{:paths ["src"]}\n' > "$deps_file"
check_exact "missing deps is empty" 0 \
  '=> Installed: 0  Already: 0  Total: 0' \
  "$grenadine" --add "$deps_file"

printf '{:deps []}\n' > "$deps_file"
check "deps map validation" 1 ':deps must be a map' \
  "$grenadine" --add "$deps_file"

printf '{:deps {org.example/demo {:git/url "https://example.invalid"}}}\n' \
  > "$deps_file"
check "incomplete Git coordinate" 1 'requires :git/sha' \
  "$grenadine" "--repository=$explicit_repo" --add "$deps_file"

local_lib="$temporary/local-lib"
mkdir -p "$local_lib/src"
printf '{:paths ["src"] :deps {}}\n' > "$local_lib/deps.edn"
printf '{:deps {example/local {:local/root "./local-lib"}}}\n' > "$deps_file"
check_exact "expand local coordinate" 0 \
  "example/local $local_lib" \
  "$grenadine" --expand "$deps_file"
check_exact "list local coordinate" 0 \
  $'example/local '"$local_lib"$'\n=> Installed: 1  Missing: 0  Total: 1' \
  "$grenadine" --list "$deps_file"
check_exact "add local coordinate" 0 \
  '=> Installed: 0  Already: 1  Total: 1' \
  "$grenadine" --add "$deps_file"
check "delete rejects local coordinate" 1 \
  'support only Maven coordinates' \
  "$grenadine" --delete "$deps_file"
check "remove rejects local coordinate" 1 \
  'support only Maven coordinates' \
  "$grenadine" --remove "$deps_file"

if (( failures )); then
  echo "$failures of $checks CLI checks failed" >&2
  exit 1
fi

echo "$checks CLI checks passed"
