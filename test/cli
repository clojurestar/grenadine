  $'demo/branch  1.0.0\ndemo/c       1.0.0  2.1.0\ndemo/root    1.0.0  1.1.0' \
  "$grenadine" --mediator nearest --current "$current_deps"
check_empty "quiet current" 0 \
  "$grenadine" --quiet --current "$current_deps"

empty_repo="$temporary/empty-repo"
mkdir -p "$empty_repo"
check_empty "current empty selected repository" 0 \
  "$grenadine" --repository "$empty_repo" --current
check_empty "current empty repository directory item" 0 \
  "$grenadine" --current "$empty_repo"
check "current operation conflict" 1 \
  '--list, --current, --install' "$grenadine" --list --current
check "current directory conflicts with repository option" 1 \
  'cannot combine a repository directory with --repository' \
  "$grenadine" --repository "$empty_repo" --current "$empty_repo"
check "current plain inventory rejects mediator" 1 \
  '--mediator is only valid with --install.*--current with items' \
  "$grenadine" --mediator newest --current

write_pom "$resolve_repo" demo unknown 1.0.0 ''
unknown_deps="$temporary/unknown-deps.edn"
printf '{:mvn/local-repo "%s" :mvn/repos {"central" {:url "%s"} "clojars" {:url "%s"}} :deps {demo/unknown {:mvn/version "1.0.0"}}}\n' \
  "$resolve_repo" "$server_url" "$server_url" > "$unknown_deps"
check "current warns and continues when metadata is unavailable" 0 \
  'warning: cannot determine latest version for demo/unknown' \
  "$grenadine" --current "$unknown_deps"

