  $'Removed demo/branch 1.0.0\nRemoved demo/c 2.0.0\nRemoved demo/root 1.0.0\n=> Removed: 3  Missing: 0  Total: 3' \
  "$grenadine" --repository "$resolve_repo" --remove demo/root 1.0.0
check_empty "remove leaves unselected version" 0 \
  test -e "$resolve_repo/demo/c/1.0.0/c-1.0.0.jar"

