seed_list_repo "$remove_repo"
check_exact "delete one version" 0 \
  $'Deleted org.example/demo 1.0.0\n=> Deleted: 1  Missing: 0  Total: 1' \
  "$grenadine" --repository "$remove_repo" \
    --delete org.example/demo 1.0.0
check_empty "removed version is gone" 0 \
  test ! -e "$remove_repo/org/example/demo/1.0.0"
check_exact "delete all versions" 0 \
  $'Deleted org.alpha/example (all versions)\n=> Deleted: 1  Missing: 0  Total: 1' \
  "$grenadine" --repository "$remove_repo" --delete org.alpha/example
