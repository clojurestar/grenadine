#!/usr/bin/env bash

set -euo pipefail

grenadine=${GRENADINE:?GRENADINE is required}
top=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
version=$(sed -n \
  's/^GRENADINE-VERSION := \([0-9][0-9.]*\)$/\1/p' \
  "$top/Makefile")
version_pattern=${version//./\\.}
temporary=$(mktemp -d)
server_pid=

cleanup() {
  if [[ $server_pid ]]; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
  rm -rf "$temporary"
}

trap cleanup EXIT

failures=0
checks=0

start_http_server() {
  local root=$1 port_file="$temporary/http-port"
  rm -f "$port_file"
  python3 - "$root" "$port_file" "$temporary/http-requests" <<'PY' &
import functools
import http.server
import pathlib
import sys

root, port_file, request_file = sys.argv[1:]
class QuietHandler(http.server.SimpleHTTPRequestHandler):
    def log_message(self, _format, *_args):
        pass

    def guess_type(self, _path):
        return "application/octet-stream"

    def do_GET(self):
        with pathlib.Path(request_file).open("a", encoding="utf-8") as requests:
            requests.write(self.path + "\n")
        super().do_GET()

handler = functools.partial(QuietHandler, directory=root)
server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), handler)
pathlib.Path(port_file).write_text(str(server.server_port), encoding="utf-8")
server.serve_forever()
PY
  server_pid=$!
  for _ in {1..100}; do
    [[ -s $port_file ]] && break
    sleep 0.05
  done
  [[ -s $port_file ]] || {
    echo "failed to start fixture HTTP server" >&2
    exit 1
  }
  server_url="http://127.0.0.1:$(<"$port_file")/"
}

check() {
  local description=$1 expected_status=$2 expected_pattern=$3
  shift 3
  local output status
  set +e
  output=$("$@" 2>&1)
  status=$?
  set -e
  checks=$((checks + 1))
  if [[ $status != "$expected_status" ]] ||
     ! grep -Eq -- "$expected_pattern" <<< "$output"; then
    echo "not ok $checks - $description" >&2
    echo "  status: $status" >&2
    echo "  output: $output" >&2
    failures=$((failures + 1))
  else
    echo "ok $checks - $description"
  fi
}

check_empty() {
  local description=$1 expected_status=$2
  shift 2
  local output status
  set +e
  output=$("$@" 2>&1)
  status=$?
  set -e
  checks=$((checks + 1))
  if [[ $status != "$expected_status" || -n $output ]]; then
    echo "not ok $checks - $description" >&2
    echo "  status: $status" >&2
    echo "  output: $output" >&2
    failures=$((failures + 1))
  else
    echo "ok $checks - $description"
  fi
}

check_exact() {
  local description=$1 expected_status=$2 expected_output=$3
  shift 3
  local output status
  set +e
  output=$("$@" 2>&1)
  status=$?
  set -e
  checks=$((checks + 1))
  if [[ $status != "$expected_status" || $output != "$expected_output" ]]; then
    echo "not ok $checks - $description" >&2
    echo "  status: $status" >&2
    echo "  output: $output" >&2
    failures=$((failures + 1))
  else
    echo "ok $checks - $description"
  fi
}

run_with_stdin() {
  local input=$1
  shift
  "$@" <<< "$input"
}

seed_repo() {
  local repository=$1
  local base=$repository/org/example/demo/1.0.0
  mkdir -p "$base"
  printf '%s\n' \
    '<project>' \
    '  <modelVersion>4.0.0</modelVersion>' \
    '  <groupId>org.example</groupId>' \
    '  <artifactId>demo</artifactId>' \
    '  <version>1.0.0</version>' \
    '</project>' > "$base/demo-1.0.0.pom"
  printf 'fixture jar\n' > "$base/demo-1.0.0.jar"
}

write_jar() {
  local jar=$1 entry=$2
  python3 - "$jar" "$entry" <<'PY'
import pathlib
import sys
import zipfile

jar, entry = sys.argv[1:]
pathlib.Path(jar).parent.mkdir(parents=True, exist_ok=True)
with zipfile.ZipFile(jar, "w") as archive:
    archive.writestr(entry, "(ns demo.loadable)\n")
PY
}

seed_list_repo() {
  local repository=$1
  seed_repo "$repository"
  mkdir -p \
    "$repository/org/alpha/example/2.0.0" \
    "$repository/org/parent/bom/3.0.0"
  printf 'fixture jar\n' \
    > "$repository/org/alpha/example/2.0.0/example-2.0.0.jar"
  printf 'sources jar\n' \
    > "$repository/org/alpha/example/2.0.0/example-2.0.0-sources.jar"
  printf '<project/>\n' \
    > "$repository/org/parent/bom/3.0.0/bom-3.0.0.pom"
}

write_pom() {
  local repository=$1 group=$2 artifact=$3 version=$4 dependencies=$5
  local group_path=${group//./\/}
  local base=$repository/$group_path/$artifact/$version
  mkdir -p "$base"
  printf '%s\n' \
    '<project>' \
    '  <modelVersion>4.0.0</modelVersion>' \
    "  <groupId>$group</groupId>" \
    "  <artifactId>$artifact</artifactId>" \
    "  <version>$version</version>" \
    "  <dependencies>$dependencies</dependencies>" \
    '</project>' > "$base/$artifact-$version.pom"
}

write_metadata() {
  local repository=$1 group=$2 artifact=$3 release=$4
  local group_path=${group//./\/}
  local base=$repository/$group_path/$artifact
  mkdir -p "$base"
  printf '%s\n' \
    '<metadata><versioning>' \
    "<release>$release</release>" \
    "<versions><version>$release</version></versions>" \
    '</versioning></metadata>' > "$base/maven-metadata.xml"
}

seed_resolve_repo() {
  local repository=$1
  write_pom "$repository" demo root 1.0.0 \
    '<dependency><groupId>demo</groupId><artifactId>c</artifactId><version>1.0.0</version></dependency><dependency><groupId>demo</groupId><artifactId>branch</artifactId><version>1.0.0</version></dependency>'
  write_pom "$repository" demo branch 1.0.0 \
    '<dependency><groupId>demo</groupId><artifactId>c</artifactId><version>2.0.0</version></dependency>'
  write_pom "$repository" demo c 1.0.0 ''
  write_pom "$repository" demo c 2.0.0 ''
}

write_deps() {
  local file=$1 local_repo=${2:-}
  if [[ $local_repo ]]; then
    printf '{:mvn/local-repo "%s" :deps {org.example/demo {:mvn/version "1.0.0"}}}\n' \
      "$local_repo" > "$file"
  else
    printf '{:deps {org.example/demo {:mvn/version "1.0.0"}}}\n' > "$file"
  fi
}

check "version" 0 "^grenadine v${version_pattern}$" "$grenadine" --version
check "removed version shortcut" 1 'unknown option: -V' "$grenadine" -V
check "help" 0 '^Usage: grenadine' "$grenadine" --help
help_output=$("$grenadine" --help)
check_empty "help omits deprecated add alias" 1 \
  grep -F -- '--add' <<< "$help_output"
check_exact "no arguments show help" 0 "$help_output" "$grenadine"
check "unknown option" 1 'unknown option: --wat' "$grenadine" --wat
check "removed repo option" 1 'unknown option: --repo' "$grenadine" --repo=somewhere
check "bare deps source rejected" 1 'an explicit operation is required' \
  "$grenadine" deps.edn
check "removed resolve option" 1 'unknown option: --resolve' \
  "$grenadine" --resolve demo/root
check "removed resolver option" 1 'unknown option: --resolver' \
  "$grenadine" --resolver newest --expand demo/root
check "removed resolvers option" 1 'unknown option: --resolvers' \
  "$grenadine" --resolvers

list_repo="$temporary/list repo"
seed_list_repo "$list_repo"
check_exact "list repository" 0 \
  $'org.alpha/example  2.0.0\norg.example/demo   1.0.0' \
  "$grenadine" --repository "$list_repo" --list
check_exact "list environment repository" 0 \
  $'org.alpha/example  2.0.0\norg.example/demo   1.0.0' \
  env GRENADINE_MAVEN_REPOSITORY="$list_repo" "$grenadine" --list
check_exact "list repository directory item" 0 \
  $'org.alpha/example  2.0.0\norg.example/demo   1.0.0' \
  "$grenadine" --list "$list_repo"
check_empty "quiet list" 0 \
  "$grenadine" --quiet --repository="$list_repo" --list
operation_conflict=
operation_conflict+='--list, --current, --install, --delete, --remove, '
operation_conflict+='--expand, --loadpath, and --mediators are mutually exclusive'
check "operation conflict" 1 \
  "$operation_conflict" \
  "$grenadine" --list --install org.example/demo 1.0.0

check_exact "list mediation strategies" 0 \
  $'newest     Select the highest Maven-compatible version\nnearest    Select the shortest path, then declaration order\ntools-deps Preserve direct dependencies; otherwise select newest (default)' \
  "$grenadine" --mediators
check "mediators reject quiet" 1 '--mediators does not use --quiet' \
  "$grenadine" --quiet --mediators
check "mediators reject items" 1 '--mediators does not accept items' \
  "$grenadine" --mediators demo/root
check "mediators reject repository" 1 '--mediators does not use --repository' \
  "$grenadine" --repository somewhere --mediators
check "mediators reject gitlibs" 1 '--mediators does not use --gitlibs' \
  "$grenadine" --gitlibs somewhere --mediators
check "mediator rejects unknown strategy" 1 \
  'unknown mediation strategy: random' \
  "$grenadine" --mediator=random --expand demo/root 1.0.0
check "mediator rejects plain list" 1 \
  '--mediator is only valid' "$grenadine" --mediator newest --list
check "mediator rejects repository directory list" 1 \
  '--mediator is only valid with --list when dependency items are supplied' \
  "$grenadine" --mediator newest --list "$list_repo"
check "mediator requires a compatible operation" 1 \
  '--mediator is only valid' "$grenadine" --mediator newest
check "expand requires an item" 1 \
  '--expand requires at least one item' "$grenadine" --expand

resolve_repo="$temporary/resolve repo"
seed_resolve_repo "$resolve_repo"
write_pom "$resolve_repo" hiccup hiccup 1.0.5 ''
write_pom "$resolve_repo" org.lwjgl lwjgl-stb 3.2.3 ''
check_exact "expand unqualified legacy library" 0 \
  '└── hiccup 1.0.5' \
  "$grenadine" --repository "$resolve_repo" --expand hiccup 1.0.5
check_exact "expand Maven classifier" 0 \
  "└── org.lwjgl/lwjgl-stb\$natives-macos 3.2.3" \
  "$grenadine" --repository "$resolve_repo" --expand \
    "org.lwjgl/lwjgl-stb\$natives-macos" 3.2.3
check_exact "expand defaults to tools-deps" 0 \
  $'└── demo/root 1.0.0\n    ├── demo/branch 1.0.0\n    │   └── demo/c 2.0.0\n    └── demo/c 2.0.0 (already shown)' \
  "$grenadine" --repository "$resolve_repo" --expand demo/root 1.0.0
check_exact "expand with nearest" 0 \
  $'└── demo/root 1.0.0\n    ├── demo/branch 1.0.0\n    │   └── demo/c 1.0.0\n    └── demo/c 1.0.0 (already shown)' \
  "$grenadine" --repository "$resolve_repo" --mediator=nearest \
    --expand demo/root 1.0.0
check_exact "expand with short mediator" 0 \
  $'└── demo/root 1.0.0\n    ├── demo/branch 1.0.0\n    │   └── demo/c 2.0.0\n    └── demo/c 2.0.0 (already shown)' \
  "$grenadine" --repository "$resolve_repo" -M newest \
    --expand demo/root 1.0.0
check_exact "expand with short option" 0 \
  $'└── demo/root 1.0.0\n    ├── demo/branch 1.0.0\n    │   └── demo/c 2.0.0\n    └── demo/c 2.0.0 (already shown)' \
  "$grenadine" --repository "$resolve_repo" -X demo/root 1.0.0
check_exact "tools-deps preserves direct root" 0 \
  $'├── demo/c 1.0.0\n└── demo/root 1.0.0\n    ├── demo/branch 1.0.0\n    │   └── demo/c 1.0.0 (already shown)\n    └── demo/c 1.0.0 (already shown)' \
  "$grenadine" --repository "$resolve_repo" --mediator=tools-deps \
    --expand demo/root 1.0.0 demo/c 1.0.0
check_empty "quiet expand" 0 \
  "$grenadine" --quiet --repository "$resolve_repo" \
    --expand demo/root 1.0.0
check_empty "expand installs no jars" 0 \
  find "$resolve_repo" -name '*.jar' -print

tree_repo="$temporary/tree repo"
write_pom "$tree_repo" tree root 1.0.0 \
  '<dependency><groupId>tree</groupId><artifactId>a</artifactId><version>1.0.0</version></dependency><dependency><groupId>tree</groupId><artifactId>b</artifactId><version>1.0.0</version></dependency><dependency><groupId>tree</groupId><artifactId>hidden</artifactId><version>1.0.0</version><scope>test</scope></dependency><dependency><groupId>tree</groupId><artifactId>optional</artifactId><version>1.0.0</version><optional>true</optional></dependency>'
write_pom "$tree_repo" tree a 1.0.0 \
  '<dependency><groupId>tree</groupId><artifactId>shared</artifactId><version>1.0.0</version><exclusions><exclusion><groupId>tree</groupId><artifactId>leaf</artifactId></exclusion></exclusions></dependency>'
write_pom "$tree_repo" tree b 1.0.0 \
  '<dependency><groupId>tree</groupId><artifactId>shared</artifactId><version>1.0.0</version></dependency>'
write_pom "$tree_repo" tree shared 1.0.0 \
  '<dependency><groupId>tree</groupId><artifactId>leaf</artifactId><version>1.0.0</version></dependency><dependency><groupId>tree</groupId><artifactId>root</artifactId><version>1.0.0</version></dependency>'
write_pom "$tree_repo" tree leaf 1.0.0 ''
for mediator in tools-deps nearest newest; do
  check_exact "tree merges exclusions and stops cycles ($mediator)" 0 \
    $'└── tree/root 1.0.0\n    ├── tree/a 1.0.0\n    │   └── tree/shared 1.0.0\n    │       ├── tree/leaf 1.0.0\n    │       └── tree/root 1.0.0 (cycle)\n    └── tree/b 1.0.0\n        └── tree/shared 1.0.0 (already shown)' \
    "$grenadine" --repository "$tree_repo" -M "$mediator" -X tree/root 1.0.0
done
check_empty "tree expansion installs no jars" 0 \
  find "$tree_repo" -name '*.jar' -print

write_pom "$tree_repo" version root 1.0.0 \
  '<dependency><groupId>version</groupId><artifactId>shared</artifactId><version>2.0.0</version></dependency>'
write_pom "$tree_repo" version shared 1.0.0 \
  '<dependency><groupId>version</groupId><artifactId>old</artifactId><version>1.0.0</version></dependency>'
write_pom "$tree_repo" version shared 2.0.0 \
  '<dependency><groupId>version</groupId><artifactId>new</artifactId><version>1.0.0</version></dependency>'
write_pom "$tree_repo" version old 1.0.0 ''
write_pom "$tree_repo" version new 1.0.0 ''
check_exact "tree follows newest selected subtree" 0 \
  $'├── version/root 1.0.0\n│   └── version/shared 2.0.0\n│       └── version/new 1.0.0\n└── version/shared 2.0.0 (already shown)' \
  "$grenadine" --repository "$tree_repo" -M newest -X \
    version/root 1.0.0 version/shared 1.0.0
for mediator in nearest tools-deps; do
  check_exact "tree follows direct selected subtree ($mediator)" 0 \
    $'├── version/root 1.0.0\n│   └── version/shared 1.0.0\n│       └── version/old 1.0.0\n└── version/shared 1.0.0 (already shown)' \
    "$grenadine" --repository "$tree_repo" -M "$mediator" -X \
      version/root 1.0.0 version/shared 1.0.0
done

printf 'fixture jar\n' > "$resolve_repo/demo/root/1.0.0/root-1.0.0.jar"
check_exact "list expanded graph marks missing jars" 0 \
  $'demo/branch  1.0.0  MISSING\ndemo/c       2.0.0  MISSING\ndemo/root    1.0.0\n=> Installed: 1  Missing: 2  Total: 3' \
  "$grenadine" --repository "$resolve_repo" --list demo/root 1.0.0
check_empty "quiet expanded list" 0 \
  "$grenadine" --quiet --repository "$resolve_repo" \
    --list demo/root 1.0.0

current_remote="$temporary/current-remote"
seed_resolve_repo "$current_remote"
write_metadata "$current_remote" demo branch 1.0.0
write_metadata "$current_remote" demo c 2.1.0
write_metadata "$current_remote" demo root 1.1.0
start_http_server "$current_remote"
current_deps="$temporary/current-deps.edn"
printf '{:mvn/local-repo "%s" :mvn/repos {"central" {:url "%s"} "clojars" {:url "%s"}} :deps {demo/root {:mvn/version "1.0.0"}}}\n' \
  "$resolve_repo" "$server_url" "$server_url" > "$current_deps"
remote_relative_deps="$current_remote/relative-local.edn"
printf '{:mvn/local-repo "%s" :deps {example/local {:local/root "./local-lib"} demo/root {:mvn/version "1.0.0"}}}\n' \
  "$resolve_repo" > "$remote_relative_deps"
check_exact "remote relative local root warns and continues" 0 \
  $'grenadine: warning: skipping example/local from '"${server_url}relative-local.edn"$': relative :local/root "./local-lib"\n└── demo/root 1.0.0\n    ├── demo/branch 1.0.0\n    │   └── demo/c 2.0.0\n    └── demo/c 2.0.0 (already shown)' \
  "$grenadine" --expand "${server_url}relative-local.edn"
check_empty "quiet remote relative local root continues" 0 \
  "$grenadine" --quiet --expand "${server_url}relative-local.edn"

project_repo="$temporary/project repo"
project_file="$temporary/project.clj"
printf '%s\n' \
  '(defproject demo/project "1.0.0"'\
" :local-repo \"$resolve_repo\""\
' :source-paths #=(os.Exit 78)'\
' :jar-exclusions [#"^(?!demo)"]'\
' #_#_ :dependencies [[demo/root "1.0.0"]]'\
' :dependencies [[demo/c "1.0.0"'\
' :classifier "tests" :optional true :native-prefix ""]])' \
  > "$project_file"
check_exact "expand local literal project" 0 \
  "└── demo/c\$tests 1.0.0" \
  "$grenadine" --expand "$project_file"
check_empty "quiet local literal project" 0 \
  "$grenadine" --quiet --expand "$project_file"

remote_project="$current_remote/project.clj"
printf '(defproject demo/remote "1.0.0" :local-repo "%s" :repositories [["central" "%s"] ["clojars" {:url "%s" :snapshots false}]] :exclusions [demo/branch] :dependencies [[demo/root "1.0.0" :optional false]])\n' \
  "$project_repo" "$server_url" "$server_url" > "$remote_project"
check_exact "expand remote literal project" 0 \
  $'└── demo/root 1.0.0\n    └── demo/c 1.0.0' \
  "$grenadine" --expand "${server_url}project.clj"
check_exact "mixed project and name use last root" 0 \
  $'├── demo/c 2.0.0\n└── demo/root 1.0.0\n    └── demo/c 2.0.0 (already shown)' \
  "$grenadine" --expand "${server_url}project.clj" demo/c 2.0.0

opaque_version_project="$temporary/opaque-version-project.clj"
printf '(defproject demo/opaque #=(clojure.string/trim #=(slurp "resources/VERSION")) :local-repo "%s" :dependencies [[demo/c "1.0.0"]])\n' \
  "$resolve_repo" \
  > "$opaque_version_project"
check_exact "project version form is ignored without evaluation" 0 \
  "└── demo/c 1.0.0" \
  "$grenadine" --expand "$opaque_version_project"

unsafe_project="$temporary/unsafe-project.clj"
printf '(defproject demo/unsafe "1.0.0" :dependencies #=(os.Exit 77))\n' \
  > "$unsafe_project"
check "project reader evaluation is disabled in consumed fields" 1 \
  'cannot parse' \
  "$grenadine" --expand "$unsafe_project"

dynamic_project="$temporary/dynamic-project.clj"
printf '(defproject demo/dynamic "1.0.0" :dependencies (concat [[demo/c "1.0.0"]]))\n' \
  > "$dynamic_project"
check "project requires literal dependencies" 1 \
  ':dependencies must be a literal vector' \
  "$grenadine" --expand "$dynamic_project"

missing_version_project="$temporary/missing-version-project.clj"
printf '(defproject demo/managed "1.0.0" :managed-dependencies [[demo/c "1.0.0"]] :dependencies [[demo/c]])\n' \
  > "$missing_version_project"
check "project requires direct literal versions" 1 \
  'demo/c requires a literal version string' \
  "$grenadine" --expand "$missing_version_project"

unsupported_project="$temporary/unsupported-project.clj"
printf '(defproject demo/unsupported "1.0.0" :dependencies [[demo/c "1.0.0" :extension "pom"]])\n' \
  > "$unsupported_project"
check "project rejects unsupported dependency options" 1 \
  'demo/c uses unsupported :extension "pom"' \
  "$grenadine" --expand "$unsupported_project"

nonproject_file="$temporary/not-project.clj"
printf '(ns demo.not-project)\n' > "$nonproject_file"
check "project source requires defproject" 1 \
  'must start with defproject' \
  "$grenadine" --expand "$nonproject_file"
check "missing project source is not parsed as a library" 1 \
  'cannot read .*missing/project.clj' \
  "$grenadine" --expand "$temporary/missing/project.clj"

: > "$temporary/http-requests"
check_exact "current tree shows available updates" 0 \
  $'└── demo/root 1.0.0 -> 1.1.0\n    ├── demo/branch 1.0.0\n    │   └── demo/c 2.0.0 -> 2.1.0\n    └── demo/c 2.0.0 -> 2.1.0 (already shown)' \
  "$grenadine" --current "$current_deps"
check_exact "current checks shared library metadata once" 0 '1' \
  grep -c '^/demo/c/maven-metadata.xml$' "$temporary/http-requests"
check_exact "current expanded graph accepts mediation" 0 \
  $'└── demo/root 1.0.0 -> 1.1.0\n    ├── demo/branch 1.0.0\n    │   └── demo/c 1.0.0 -> 2.1.0\n    └── demo/c 1.0.0 -> 2.1.0 (already shown)' \
  "$grenadine" --mediator nearest --current "$current_deps"
: > "$temporary/http-requests"
check_empty "quiet current" 0 \
  "$grenadine" --quiet --current "$current_deps"
check_empty "quiet current skips update checks" 0 \
  cat "$temporary/http-requests"

write_metadata "$current_remote" demo c 1.0.0
check_exact "current ignores older remote versions" 0 \
  $'└── demo/root 1.0.0 -> 1.1.0\n    ├── demo/branch 1.0.0\n    │   └── demo/c 2.0.0\n    └── demo/c 2.0.0 (already shown)' \
  "$grenadine" --current "$current_deps"
write_metadata "$current_remote" demo c 2.1.0

write_pom "$tree_repo" org.clojure clojure 1.0.0 \
  '<dependency><groupId>org.clojure</groupId><artifactId>spec.alpha</artifactId><version>1.0.0</version></dependency><dependency><groupId>org.clojure</groupId><artifactId>core.specs.alpha</artifactId><version>1.0.0</version></dependency>'
write_pom "$tree_repo" org.clojure spec.alpha 1.0.0 ''
write_pom "$tree_repo" org.clojure core.specs.alpha 1.0.0 ''
current_hidden="$temporary/current-hidden.edn"
printf '{:mvn/local-repo "%s" :mvn/repos {"central" {:url "%s"} "clojars" {:url "%s"}} :deps {org.clojure/clojure {:mvn/version "1.0.0"}}}\n' \
  "$tree_repo" "$server_url" "$server_url" > "$current_hidden"
: > "$temporary/http-requests"
check_empty "current hides Clojure and its exclusive descendants" 0 \
  "$grenadine" --current "$current_hidden"
check_empty "hidden tree skips all metadata lookups" 0 \
  cat "$temporary/http-requests"
write_metadata "$current_remote" org.clojure spec.alpha 1.1.0
check_exact "current retains independently requested spec" 0 \
  '└── org.clojure/spec.alpha 1.0.0 -> 1.1.0' \
  "$grenadine" --current "$current_hidden" org.clojure/spec.alpha 1.0.0

for artifact in root a b shared leaf; do
