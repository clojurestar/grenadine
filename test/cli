seed_repo "$install_repo"
check_exact "install explicit version" 0 \
  '=> Installed: 0  Already: 1  Total: 1' \
  "$grenadine" --mediator=newest --repository "$install_repo" \
    --install org.example/demo 1.0.0
check_empty "quiet install" 0 \
  "$grenadine" --quiet --repository "$install_repo" \
    --install org.example/demo 1.0.0
check "deprecated add alias warns and installs" 0 \
  'warning: --add is deprecated; use --install' \
  "$grenadine" --repository "$install_repo" \
    --add org.example/demo 1.0.0
check "quiet deprecated add alias still warns" 0 \
  'warning: --add is deprecated; use --install' \
  "$grenadine" --quiet --repository "$install_repo" \
    --add org.example/demo 1.0.0
