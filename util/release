#!/usr/bin/env bash

set -euo pipefail

command=${1:?usage: release release|prepare|publish|mark-deployed VERSION}
version=${2:?usage: release release|prepare|publish|mark-deployed VERSION}
version=${version#v}

[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
  echo "release: VERSION must have the form X.Y.Z" >&2
  exit 1
}

top=$(git rev-parse --show-toplevel)
changes_file="$top/Changes"
version_file="$top/VERSION"
project_file="$top/project.clj"
deployed_marker="$top/.cache/clojars/$version.deployed"
secrets_file=${PUBLISH_SECRETS:-${HOME:?}/.publish-secrets}
bb=${BB:-bb}

has_changes_entry() {
  grep -q "^- version: $version\$" "$changes_file"
}

project_version() {
  sed -n \
    's/^(defproject cc\.clojure\/grenadine "\([^"]*\)".*/\1/p' \
    "$project_file"
}

version_reference_files() {
  local pattern=${1//./\\.}
  git grep -IlE "(^|[^0-9.])$pattern([^0-9.]|$)" -- . \
    ':(exclude)Changes' ':(exclude)test/**' || true
}

release_files() {
  {
    echo Changes
    version_reference_files "$version"
  } | sort -u
}

bump_version_references() {
  local current=$1 file
  while IFS= read -r file; do
    [[ -n $file ]] || continue
    OLD_VERSION="$current" NEW_VERSION="$version" perl -pi -e \
      's/(?<![0-9.])\Q$ENV{OLD_VERSION}\E(?![0-9.])/$ENV{NEW_VERSION}/g' \
      "$file"
  done < <(version_reference_files "$current")
}

set_project_version() {
  local temporary
  temporary=$(mktemp)
  awk -v version="$version" \
    'NR == 1 { sub(/"[^"]+"/, "\"" version "\"") } { print }' \
    "$project_file" > "$temporary"
  head -1 "$temporary" |
    grep -Fqx "(defproject cc.clojure/grenadine \"$version\""
  mv "$temporary" "$project_file"
}

prepare() {
  if [[ $(< "$version_file") == "$version" ]] && has_changes_entry; then
    if [[ $(project_version) == "$version" ]]; then
      echo "Release v$version is already prepared"
      return
    fi
    [[ -z $(git status --short) ]] || {
      echo "release: prepare requires a clean worktree" >&2
      exit 1
    }
    set_project_version
    echo "Release v$version project metadata prepared"
    return
  fi
  [[ -z $(git status --short) ]] || {
    echo "release: prepare requires a clean worktree" >&2
    exit 1
  }

  local current previous_tag changes temporary previous_changes
  current=$(< "$version_file")
  [[ $(project_version) == "$current" ]] || {
    echo "release: VERSION and project.clj do not agree" >&2
    exit 1
  }
  previous_tag=$(git tag -l 'v[0-9]*' --sort=-v:refname | head -1)
  if [[ -n $previous_tag ]]; then
    changes=$(git log "$previous_tag"..HEAD --format='%s' |
      grep -v "^Version $version\$" || true)
  else
    changes=$(git log HEAD --format='%s')
  fi
  temporary=$(mktemp)
  previous_changes=$(sed '/^# Grenadine release history$/d' "$changes_file")
  {
    echo "- version: $version"
    echo "  date:    $(date)"
    echo "  changes:"
    if [[ -n $changes ]]; then
      while IFS= read -r line; do echo "  - $line"; done <<< "$changes"
    else
      echo "  - Release v$version"
    fi
    if [[ -n $previous_changes ]]; then
      echo
      printf '%s\n' "$previous_changes"
    fi
  } > "$temporary"
  mv "$temporary" "$changes_file"
  bump_version_references "$current"

  if [[ -n $(version_reference_files "$current") ]]; then
    echo "release: failed to replace every current-version reference" >&2
    exit 1
  fi

  if [[ ${RELEASE_EDIT:-1} != 0 ]]; then
    "${EDITOR:-vi}" "$changes_file"
  fi
  if [[ ${RELEASE_CONFIRM:-1} != 0 ]]; then
    read -rp "Continue preparing v$version? Enter to continue, Ctrl-C to cancel. "
  fi
}

release_notes() {
  awk -v version="$version" '
    /^- version:/ { if (found) exit; found = ($3 == version); next }
    found && /^  - / { sub(/^  - /, "- "); print }
  ' "$changes_file"
}

release_commit_ready() {
  local changed expected
  [[ $(< "$version_file") == "$version" ]] || return 1
  has_changes_entry || return 1
  [[ $(project_version) == "$version" ]] || return 1
  [[ $(git log -1 --format=%s) == "Release $version" ]] || return 1
  changed=$(git diff-tree --no-commit-id --name-only -r HEAD | sort)
  expected=$(release_files)
  [[ $changed == "$expected" ]]
}

load_clojars_credentials() {
  local file_user file_token
  if [[ -r $secrets_file ]] &&
     { [[ -x $bb ]] || command -v "$bb" >/dev/null 2>&1; }; then
    file_user=$(
      "$bb" -e '
        (require (quote [clj-yaml.core :as yaml]))
        (let [[file] *command-line-args*
              value (get-in (yaml/parse-string (slurp file))
                            [:clojure :user])]
          (when-not (and (string? value) (seq value))
            (throw (ex-info "missing .clojure.user" {})))
          (print value))' "$secrets_file" 2>/dev/null
    ) || file_user=
    file_token=$(
      "$bb" -e '
        (require (quote [clj-yaml.core :as yaml]))
        (let [[file] *command-line-args*
              value (get-in (yaml/parse-string (slurp file))
                            [:clojure :token])]
          (when-not (and (string? value) (seq value))
            (throw (ex-info "missing .clojure.token" {})))
          (print value))' "$secrets_file" 2>/dev/null
    ) || file_token=
    if [[ -n $file_user && -n $file_token ]]; then
      CLOJARS_USERNAME=$file_user
      CLOJARS_PASSWORD=$file_token
      export CLOJARS_USERNAME CLOJARS_PASSWORD
      return
    fi
  fi

  [[ -n ${CLOJARS_USERNAME:-} && -n ${CLOJARS_PASSWORD:-} ]] || {
    echo "release: no complete Clojars credentials in $secrets_file or the environment" >&2
    exit 1
  }
}

validate_git_context() {
  local branch
  branch=$(git branch --show-current)
  [[ $branch == main ]] || {
    echo "release: releases must be made from main, not $branch" >&2
    exit 1
  }
  [[ -z $(git status --short) ]] || {
    echo "release: release requires a clean worktree" >&2
    exit 1
  }
  if ! git var GIT_AUTHOR_IDENT >/dev/null 2>&1 ||
     ! git var GIT_COMMITTER_IDENT >/dev/null 2>&1; then
      echo "release: Git author and committer identities must be available" >&2
      exit 1
  fi
  git remote get-url origin >/dev/null 2>&1 || {
    echo "release: git remote origin is not configured" >&2
    exit 1
  }
}

validate_release_state() {
  local tag
  validate_git_context
  if [[ $(< "$version_file") != "$version" ]] || ! has_changes_entry; then
    echo "release: v$version is not represented by VERSION and Changes" >&2
    exit 1
  fi
  [[ $(project_version) == "$version" ]] || {
    echo "release: project.clj does not declare v$version" >&2
    exit 1
  }
  release_commit_ready || {
    echo "release: HEAD is not the Release $version metadata commit" >&2
    exit 1
  }
  tag="v$version"
  if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
    [[ $(git rev-list -n 1 "$tag") == $(git rev-parse HEAD) ]] || {
      echo "release: tag $tag does not point to HEAD" >&2
      exit 1
    }
  fi
}

check_clojars() {
  [[ -e $deployed_marker ]] && return
  load_clojars_credentials
  if [[ ${RELEASE_SKIP_CLOJARS_GROUP_CHECK:-0} == 0 ]]; then
    curl -fsS -o /dev/null \
      "${CLOJARS_GROUP_URL:-https://clojars.org/groups/cc.clojure}" || {
      echo "release: Clojars group cc.clojure is not verified" >&2
      exit 1
    }
  fi
}

preflight_new_release() {
  local current tag
  validate_git_context
  current=$(< "$version_file")
  [[ $(project_version) == "$current" ]] || {
    echo "release: VERSION and project.clj do not agree" >&2
    exit 1
  }
  [[ $current != "$version" ]] || {
    echo "release: version $version is already current but HEAD is not its release commit" >&2
    exit 1
  }
  load_clojars_credentials
  check_clojars

  if [[ ${RELEASE_SKIP_REMOTE_CHECK:-0} == 0 ]]; then
    git fetch --quiet origin main || {
      echo "release: could not fetch origin/main" >&2
      exit 1
    }
    [[ $(git rev-parse HEAD) == $(git rev-parse origin/main) ]] || {
      echo "release: local main must exactly match origin/main before the version bump" >&2
      exit 1
    }
  fi

  tag="v$version"
  ! git rev-parse --verify --quiet "refs/tags/$tag" >/dev/null || {
    echo "release: local tag $tag already exists" >&2
    exit 1
  }
  [[ -z $(git ls-remote --tags origin "refs/tags/$tag") ]] || {
    echo "release: remote tag $tag already exists" >&2
    exit 1
  }
}

create_release_commit() {
  local changed expected
  RELEASE_EDIT=0 RELEASE_CONFIRM=0 prepare
  changed=$(git diff --name-only | sort)
  expected=$(release_files)
  [[ $changed == "$expected" ]] || {
    echo "release: version bump changed an unexpected set of files" >&2
    exit 1
  }
  [[ -z $(git ls-files --others --exclude-standard) ]] || {
    echo "release: version bump created untracked files" >&2
    exit 1
  }
  git diff --check
  while IFS= read -r file; do
    git add -- "$file"
  done <<< "$expected"
  git commit -m "Release $version"
  release_commit_ready || {
    echo "release: generated release commit is invalid" >&2
    exit 1
  }
}

release_all() {
  if release_commit_ready; then
    echo "Resuming Release $version"
  else
    preflight_new_release
    create_release_commit
  fi
  publish
}

deploy_clojars() {
  if [[ -e $deployed_marker ]]; then
    echo "Clojars cc.clojure/grenadine $version is already marked deployed"
    return
  fi
  lein deploy clojars
  mkdir -p "$(dirname "$deployed_marker")"
  touch "$deployed_marker"
}

validate_jar() {
  local jar pom listing
  jar="$top/target/grenadine-$version.jar"
  make jar
  [[ -f $jar ]] || {
    echo "release: missing $jar" >&2
    exit 1
  }
  pom=$(unzip -p "$jar" META-INF/maven/cc.clojure/grenadine/pom.xml)
  grep -Fq '<groupId>cc.clojure</groupId>' <<< "$pom"
  grep -Fq '<artifactId>grenadine</artifactId>' <<< "$pom"
  grep -Fq "<version>$version</version>" <<< "$pom"
  listing=$(unzip -Z1 "$jar")
  grep -Fxq grenadine/core.cljc <<< "$listing"
  grep -Fxq META-INF/leiningen/cc.clojure/grenadine/License \
    <<< "$listing"
}

publish() {
  local tag notes_file gh
  validate_release_state
  check_clojars
  tag="v$version"
  if [[ ${RELEASE_SKIP_REMOTE_CHECK:-0} == 0 ]]; then
    git fetch origin main
    [[ $(git rev-list --count HEAD..origin/main) == 0 ]] || {
      echo "release: origin/main contains commits not in this checkout" >&2
      exit 1
    }
  fi

  make test oracle
  validate_jar
  make release-dist VERSION="$version"
  "$top/.cache/release/bin/linux_amd64/grenadine" --version |
    grep -qx "grenadine v$version"

  if ! git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
    git tag -a "$tag" -m "Release $tag"
  fi
  [[ $(git rev-list -n 1 "$tag") == $(git rev-parse HEAD) ]] || {
    echo "release: tag $tag does not point to HEAD" >&2
    exit 1
  }

  deploy_clojars
  git push --atomic origin HEAD:main "$tag"

  notes_file="$top/.cache/release-notes-$version.md"
  release_notes > "$notes_file"
  gh=${GH:-gh}
  if "$gh" release view "$tag" --repo clojurestar/grenadine >/dev/null 2>&1; then
    "$gh" release upload "$tag" --repo clojurestar/grenadine --clobber \
      "$top"/dist/grenadine-*
  else
    "$gh" release create "$tag" --repo clojurestar/grenadine \
      --title "Grenadine $tag" --notes-file "$notes_file" \
      "$top"/dist/grenadine-*
  fi
  make publish-www
  echo "Release $tag complete"
}

mark_deployed() {
  validate_release_state
  local tag="v$version" tag_commit head_commit
  tag_commit=$(git rev-list -n 1 "$tag" 2>/dev/null || true)
  head_commit=$(git rev-parse HEAD)
  [[ $tag_commit == "$head_commit" ]] || {
    echo "release: tag $tag does not point to HEAD" >&2
    exit 1
  }
  mkdir -p "$(dirname "$deployed_marker")"
  touch "$deployed_marker"
  echo "Marked cc.clojure/grenadine $version as deployed"
}

case $command in
  release) release_all ;;
  prepare) prepare ;;
  publish) publish ;;
  mark-deployed) mark_deployed ;;
  *) echo "release: unknown command '$command'" >&2; exit 1 ;;
esac
